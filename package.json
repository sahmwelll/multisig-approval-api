{
  "name": "multisig-approval-api",
  "version": "0.1.0",
  "description": "Stellar multi-signature transaction approval API",
  "main": "dist/server.js",
  "scripts": {
  "build": "tsc",
  "start": "node dist/server.js",
  "dev": "nodemon --exec ts-node src/server.ts",
  "migrate": "node scripts/migrate.js",
  "test": "vitest run",
  "test:watch": "vitest"
},
  "dependencies": {
    "@stellar/stellar-sdk": "^11.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.6",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.1",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vitest": "^5.0.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts"
    ]
  }
}
